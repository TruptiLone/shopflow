# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=shopflow
POSTGRES_PASSWORD=shopflow
POSTGRES_DB=shopflow

# Used by the API and ingestion when running on the host (compose overrides the host to "postgres").
DATABASE_URL=postgresql+asyncpg://shopflow:shopflow@localhost:5432/shopflow

# Kaggle credentials for downloading the Olist dataset.
# Get them at https://www.kaggle.com/settings -> "Create New Token".
KAGGLE_USERNAME=
KAGGLE_KEY=

# Review translation backend: "libretranslate" (default, self-hosted container) or "none".
TRANSLATOR_BACKEND=libretranslate
LIBRETRANSLATE_URL=http://localhost:5000
